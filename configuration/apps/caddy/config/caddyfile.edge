# Caddyfile dos servidores de borda (deploy via Ansible): TLS público + conf.d.
# O Caddy local (atrás do túnel, sem TLS) usa o arquivo `caddyfile`.
{
    email {$EMAIL}
    {$CADDY_OPTS}
}

# Serviços privados: derruba a conexão de qualquer origem fora da VPN (ou containers locais).
(vpn_only) {
    @fora_da_vpn not remote_ip {$VPN_CIDR} 127.0.0.0/8 172.16.0.0/12
    abort @fora_da_vpn
}

import /etc/caddy/conf.d/*.caddy
