# Gerado pelo Ansible. Os segredos vêm do inventário; o resto é literal aqui.

# ---------- Rede ----------
COOLIFY_NETWORK_NAME=coolify

# ---------- Identidade / versão ----------
COOLIFY_VERSION=latest
COOLIFY_APP_NAME=Coolify
# Servidor local, sem DNS que resolva domínio para este IP: a URL é o IP e a
# porta. Isto é o APP_URL do Laravel — ele gera links e redirecionamentos a
# partir daqui. Apontar para um domínio que não resolve quebra a UI.
COOLIFY_URL=http://{{ inventory_hostname }}:8000
COOLIFY_AUTOUPDATE=false
COOLIFY_SSL_MODE=off
COOLIFY_PHP_MEMORY_LIMIT=512M

# ---------- Portas ----------
# 8000 é o default oficial do painel. A 8080 NÃO serve: é a porta do dashboard
# do traefik que o Coolify gera, e as duas juntas fazem o proxy falhar com
# "Bind for 0.0.0.0:8080 failed: port is already allocated" — e pior, ele fica
# "Up" sem rede e sem porta alguma, 80 e 443 incluídas.
COOLIFY_HTTP_PORT=8000
COOLIFY_REALTIME_WS_PORT=6001
COOLIFY_REALTIME_TERM_PORT=6002

# ---------- Usuário root (criado no primeiro boot pelo RootUserSeeder) ----------
# O seeder valida: domínio do e-mail tem que resolver em DNS e a senha precisa
# ter maiúscula, minúscula, número, símbolo e não aparecer em vazamentos
# conhecidos. Fora disso o usuário não é criado e não há como entrar.
COOLIFY_ROOT_USERNAME=admin
COOLIFY_ROOT_EMAIL={{ coolify_root_email }}
COOLIFY_ROOT_PASSWORD={{ coolify_root_password }}

# ---------- Segredos ----------
# APP_KEY é a chave com que o Laravel cifra o que vai para o banco — as chaves
# SSH dos servidores inclusive. Trocar depois do primeiro boot = o Coolify não
# decifra mais nada. Guarde esses valores.
COOLIFY_APP_ID={{ coolify_app_id }}
COOLIFY_APP_KEY={{ coolify_app_key }}
COOLIFY_DB_PASSWORD={{ coolify_db_password }}
COOLIFY_REDIS_PASSWORD={{ coolify_redis_password }}
COOLIFY_PUSHER_APP_ID={{ coolify_pusher_app_id }}
COOLIFY_PUSHER_APP_KEY={{ coolify_pusher_app_key }}
COOLIFY_PUSHER_APP_SECRET={{ coolify_pusher_app_secret }}
