general.import = ["C:/Users/User/AppData/Roaming/alacritty/catppuccin-mocha.toml"]

[terminal.shell]
program = "pwsh.exe"
args = ["-NoLogo", "-WorkingDirectory", "~"]

[font]
normal = { family = "FiraCode Nerd Font Propo", style = "Regular" }
bold = { family = "FiraCode Nerd Font Propo", style = "Bold" }
italic = { family = "FiraCode Nerd Font Propo", style = "Italic" }
size = 12.0

[env]
TERM = "xterm-256color"

[terminal]
