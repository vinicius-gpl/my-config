services:
  netbird-reverse-proxy:
    image: netbirdio/reverse-proxy:0.80.0
    container_name: netbird-reverse-proxy
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    environment:
      - NB_PROXY_CERTIFICATE_DIRECTORY=/certs
      - NB_PROXY_ALLOW_INSECURE=true
      - NB_PROXY_MANAGEMENT_ADDRESS={{ netbird_proxy_address | default(netbird_proxy_management_address, true) }}
      - NB_PROXY_ACME_CERTIFICATES=true
      - NB_PROXY_DOMAIN={{ netbird_proxy_domain }}
      - NB_PROXY_LOG_LEVEL=info
      - NB_PROXY_TOKEN={{ netbird_proxy_token }}
      - NB_PROXY_PRIVATE=true
      - NB_PROXY_ADDRESS=:443
    volumes:
      - proxy_certs:/certs

volumes:
  proxy_certs:
    name: proxy_certs
