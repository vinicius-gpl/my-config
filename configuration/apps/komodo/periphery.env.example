# Agente fora do Ansible (PLUTO): copie para periphery.env (não versionado) e preencha.
# O Core fica na Oracle; pela VPN o komodo.<domain> responde (vpn_only no Caddy).
PERIPHERY_CORE_ADDRESS=wss://komodo.vinicius-gpl.com
# Nome com que o servidor aparece no painel
PERIPHERY_CONNECT_AS=pluto
# Criada no painel em Settings → Onboarding; só é preciso no primeiro registro
PERIPHERY_ONBOARDING_KEY=
