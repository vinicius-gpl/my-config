# =============================================================================
#  element-call/.env.example -- EXEMPLO DE CONFIGURAÇÃO DO ELEMENT CALL
# =============================================================================

# Domínio base do servidor (o serviço responderá em call.${DOMAIN})
DOMAIN=seu-dominio.com

# Credenciais compartilhadas entre o lk-jwt-service e o LiveKit SFU
LIVEKIT_KEY=lk_element_call
LIVEKIT_SECRET=

# Versões das imagens (opcionais)
ELEMENT_CALL_VERSION=v0.28.0
SYNAPSE_VERSION=v1.163.0
LK_JWT_VERSION=v0.9.0
LIVEKIT_VERSION=v1.13.10
