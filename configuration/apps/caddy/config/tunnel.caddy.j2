# Gerado pelo Ansible a partir de `caddy_tunnels` (configuration/servers/<servidor>/vars.yml).
# Hosts servidos por outro peer da VPN: o TLS termina aqui e a requisição segue em
# HTTP pelo túnel até o Caddy local do peer. Públicos por padrão; `vpn_only: true`
# no túnel aplica o snippet `vpn_only` (de caddyfile.edge) a todos os seus hosts.
{% for tunnel in caddy_tunnels %}

{{ tunnel.hosts | map('regex_replace', '$', '.' ~ tunnel.domain) | join(', ') }} {
{% if tunnel.vpn_only | default(false) | bool %}
    import vpn_only
{% endif %}
    reverse_proxy {{ tunnel.upstream }}
}
{% endfor %}
