# =============================================================================
#  sure/.env.example -- EXEMPLO DE CONFIGURAÇÃO DO SURE (SELF-HOSTED)
# =============================================================================

# Chave mestra Rails (gerar com: openssl rand -hex 64)
SECRET_KEY_BASE=

# Banco de dados PostgreSQL
POSTGRES_USER=sure_user
POSTGRES_PASSWORD=
POSTGRES_DB=sure_production

# Porta local no host (padrão 3000)
PORT=3000

# SSL / Proxy Reverso (definir true se estiver atrás de proxy com HTTPS)
RAILS_ASSUME_SSL=false
RAILS_FORCE_SSL=false

# Fluxo de registro (open, invite_only, closed)
ONBOARDING_STATE=open

# Provedor de cotações gratuito sem API key
EXCHANGE_RATE_PROVIDER=yahoo_finance
SECURITIES_PROVIDER=yahoo_finance
